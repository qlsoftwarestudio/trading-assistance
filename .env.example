# ==========================================
# Trading Assistant - Environment Variables
# ==========================================

# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it's in .gitignore)

# ==========================================
# Database Configuration
# ==========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tradingassistant
SPRING_DATASOURCE_USERNAME=trading
SPRING_DATASOURCE_PASSWORD=trading123
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ==========================================
# Binance API Configuration
# ==========================================
# Get your API keys from: https://testnet.binancefuture.com/
# For production: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_BASE_URL=https://testnet.binancefuture.com
BINANCE_TESTNET=true

# ==========================================
# Telegram Bot Configuration (Optional)
# ==========================================
# Create bot with @BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=false

# ==========================================
# Trading Strategy Configuration
# ==========================================
TRADING_STRATEGY_ENABLED=true
TRADING_STRATEGY_SYMBOL=HYPEUSDT
TRADING_STRATEGY_TIMEFRAME=15m
TRADING_STRATEGY_RSI_LENGTH=5
TRADING_STRATEGY_RSI_OVERSOLD=30
TRADING_STRATEGY_RSI_OVERBOUGHT=70
TRADING_STRATEGY_LOOKBACK_BARS=12
TRADING_STRATEGY_KILLZONE_THRESHOLD=1.0
TRADING_STRATEGY_MIN_MOMENTUM=0.8
TRADING_STRATEGY_STOP_LOSS_PCT=2.0
TRADING_STRATEGY_TAKE_PROFIT_PCT=4.0

# ATR-based Dynamic Stop Loss (recommended over fixed % for volatile assets like HYPE)
# When enabled, ignores stop-loss-pct and calculates SL based on real volatility
TRADING_STRATEGY_USE_ATR_STOP=false
TRADING_STRATEGY_ATR_PERIOD=14
TRADING_STRATEGY_ATR_MULTIPLIER=2.0
TRADING_STRATEGY_POSITION_SIZE_PCT=20.0
TRADING_STRATEGY_LEVERAGE=5

# ==========================================
# Market Context / Multi-timeframe Analysis
# ==========================================
# Activa analisis de tendencias 1h/4h/1d + volumen + correlacion BTC
TRADING_CONTEXT_ENABLED=true
# Rechaza señales si timeframes no coinciden en direccion (mas conservador)
TRADING_CONTEXT_REQUIRE_CONFLUENCE=false
# Rechaza señales si volumen relativo es bajo
TRADING_CONTEXT_REQUIRE_VOLUME=true
# Ratio minimo de volumen relativo (1.0 = igual al promedio)
TRADING_CONTEXT_MIN_VOLUME_RATIO=1.0

# ==========================================
# Historical Performance & Auto-Adjustment
# ==========================================
# Ajusta automaticamente RSI y momentum cada 24h basado en historial
# RECOMENDADO: dejar en false las primeras 2 semanas para acumular datos
TRADING_PERFORMANCE_AUTO_ADJUST=false
# Minimo de trades por patron para ajustar (evita sobreajuste)
TRADING_PERFORMANCE_MIN_SAMPLES=20
# Delta maximo de ajuste (%)
TRADING_PERFORMANCE_ADJUSTMENT_DELTA_PCT=5.0

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# ==========================================
# Logging
# ==========================================
LOGGING_LEVEL=com.trading.assistant:DEBUG
